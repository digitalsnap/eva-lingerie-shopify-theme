<!doctype html>
<html
  class="no-js{% if request.design_mode %} shopify-design-mode{% endif %}"
  lang="{{ request.locale.iso_code }}"
  dir="{{ request.locale.direction | default: 'ltr' }}"
>
  <head>
    {%- render 'stylesheets' -%}

    {%- if settings.favicon != blank -%}
      <link
        rel="icon"
        type="image/png"
        href="{{ settings.favicon | image_url: width: 32, height: 32 }}"
      >
    {%- endif -%}

    {%- render 'meta-tags' -%}
    {%- render 'scripts' -%}
    {%- render 'theme-styles-variables' -%}
    {%- render 'color-palette' -%}
    {%- render 'eva-head' -%}

    {% if request.design_mode %}
      {%- render 'theme-editor' -%}
    {% endif %}

    {{ content_for_header }}
  </head>

  <body class="eva">
    <main
      id="MainContent"
      class="content-for-layout"
      role="main"
    >
      {{ content_for_layout }}
    </main>

    <footer class="eva-password-footer eva-scheme-ivory">
      <p class="eva-caption">
        &copy; {{ 'now' | date: '%Y' }}
        {{ shop.name | escape }}.
        {{ 'eva.footer.rights' | t }}
      </p>
      <p class="eva-caption">
        {{ 'eva.password.owner_html' | t: link: '/admin' }}
      </p>
    </footer>

    {%- form 'storefront_password', class: 'eva-password-form' -%}
      <dialog-component id="password-form">
        <dialog
          ref="dialog"
          class="eva-password-dialog eva-scheme-ivory"
          {% if form.errors %}
            open
          {% endif %}
          aria-labelledby="EvaPasswordDialogTitle"
        >
          <div class="eva-password-dialog__head">
            <h2
              id="EvaPasswordDialogTitle"
              class="eva-heading eva-heading--xs"
            >
              {{- 'eva.password.dialog_title' | t -}}
            </h2>
            <button
              type="button"
              class="eva-icon-button"
              on:click="dialog-component/closeDialog"
              aria-label="{{ 'eva.password.close' | t }}"
            >
              {%- render 'eva-icon', icon: 'close' -%}
            </button>
          </div>

          <div class="eva-form__field">
            <label for="EvaStorePassword">{{ 'eva.password.password_label' | t }}</label>
            <input
              id="EvaStorePassword"
              class="eva-form__input"
              type="password"
              name="password"
              autocomplete="current-password"
              required
              autofocus
              {% if form.errors %}
                aria-invalid="true"
                aria-describedby="EvaStorePasswordError"
              {% endif %}
            >
          </div>

          {%- if form.errors -%}
            <p
              id="EvaStorePasswordError"
              class="eva-password-dialog__error"
              role="alert"
            >
              {{- 'eva.password.wrong' | t -}}
            </p>
          {%- endif -%}

          <button
            type="submit"
            class="eva-button eva-button--primary eva-password-dialog__submit"
          >
            {{- 'eva.password.submit' | t -}}
          </button>
        </dialog>
      </dialog-component>

      {%- if form.errors -%}
        {%- comment -%}
          After a wrong password the dialog is rendered open so the error shows even without
          JavaScript; reopen it as a modal (backdrop, focus trap, Escape) once dialog.js is ready.
        {%- endcomment -%}
        <script type="module">
          customElements.whenDefined('dialog-component').then(() => {
            const component = document.getElementById('password-form');
            const dialog = component?.querySelector('dialog');
            if (!component || !dialog || dialog.matches(':modal')) return;
            dialog.close();
            component.showDialog();
          });
        </script>
      {%- endif -%}
    {%- endform -%}

    {%- style -%}
      .eva-password-footer {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 0.5rem 1.5rem;
        padding: 1.25rem var(--eva-gutter);
        border-block-start: 1px solid var(--eva-line);
      }

      .eva-password-footer a {
        color: inherit;
        text-decoration: underline;
        text-decoration-color: currentcolor;
      }

      .eva-password-dialog {
        width: min(26rem, calc(100vw - 2rem));
        padding: 1.5rem;
        border: 1px solid var(--eva-line);
        border-radius: 0;
      }

      .eva-password-dialog[open] {
        display: grid;
        gap: 1.25rem;
      }

      /* Rendered open after a wrong password: keep it centred on screen until it becomes a modal. */
      .eva-password-dialog[open]:not(:modal) {
        position: fixed;
        inset: 0;
        z-index: 10;
        height: fit-content;
        margin: auto;
      }

      .eva-password-dialog::backdrop {
        background-color: rgb(43 34 38 / 0.55);
      }

      .eva-password-dialog__head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-inline-end: -0.75rem;
      }

      .eva-password-dialog__error {
        margin: 0;
        font-size: 0.8125rem;
        color: var(--eva-wine);
      }

      .eva-password-dialog__submit {
        width: 100%;
      }
    {%- endstyle -%}
  </body>
</html>
