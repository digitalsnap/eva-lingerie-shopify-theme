{%- assign image = section.settings.image -%}

<div
  class="eva-arch-hero eva-section eva-scheme-{{ section.settings.color_scheme }}"
  style="--eva-pt: {{ section.settings.padding_top }}px; --eva-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="eva-page eva-arch-hero__inner">
    {%- if section.settings.heading != blank -%}
      <h1 class="eva-eyebrow eva-arch-hero__heading eva-rise">{{ section.settings.heading | escape }}</h1>
    {%- endif -%}

    <div class="eva-arch-hero__stage">
      {%- if section.settings.word_start != blank -%}
        <p
          class="eva-arch-hero__word eva-arch-hero__word--start eva-rise"
          style="--eva-rise-delay: 150ms;"
        >
          {{- section.settings.word_start | escape -}}
        </p>
      {%- endif -%}

      {%- comment -%}
        The photograph is the page's Largest Contentful Paint: it loads first and is never hidden by an
        entrance; only a slight settle (transform) plays on it, which costs no paint time.
      {%- endcomment -%}
      <div class="eva-arch-hero__arch eva-media">
        {%- if image != blank -%}
          {{
            image
            | image_url: width: 1400
            | image_tag:
              widths: '400, 560, 720, 960, 1200, 1400',
              sizes: '(min-width: 750px) min(32vw, 30rem), min(80vw, 22rem)',
              loading: 'eager',
              fetchpriority: 'high',
              preload: true
          }}
        {%- else -%}
          {{- 'lifestyle-1' | placeholder_svg_tag: 'eva-placeholder' -}}
        {%- endif -%}
      </div>

      {%- if section.settings.word_end != blank -%}
        <p
          class="eva-arch-hero__word eva-arch-hero__word--end eva-rise"
          style="--eva-rise-delay: 300ms;"
        >
          {{- section.settings.word_end | escape -}}
        </p>
      {%- endif -%}
    </div>

    {%- if section.settings.text != blank -%}
      <p
        class="eva-body eva-arch-hero__text eva-rise"
        style="--eva-rise-delay: 450ms;"
      >
        {{ section.settings.text }}
      </p>
    {%- endif -%}

    {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
      <a
        href="{{ section.settings.button_link }}"
        class="eva-button eva-button--primary eva-arch-hero__button eva-rise"
        style="--eva-rise-delay: 550ms;"
      >
        {{- section.settings.button_label | escape -}}
      </a>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .eva-arch-hero__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(1.25rem, 3vw, 1.75rem);
    text-align: center;
  }

  .eva-arch-hero__heading {
    margin: 0;
  }

  .eva-arch-hero__stage {
    display: grid;
    justify-items: center;
    gap: 0.75rem;
    width: 100%;
  }

  .eva-arch-hero__word {
    margin: 0;
    font-family: var(--font-accent--family);
    font-style: italic;
    font-weight: var(--font-accent--weight);
    font-size: clamp(3.25rem, 1.4rem + 6.4vw, 7.25rem);
    line-height: 1;
    letter-spacing: -0.01em;
  }

  .eva-arch-hero__arch {
    width: min(80vw, 22rem);
    aspect-ratio: 23 / 31;
    border-radius: 999px 999px 0 0;
  }

  .eva-arch-hero__text {
    max-inline-size: 30rem;
    margin: 0;
    color: var(--eva-muted);
  }

  .eva-arch-hero__button {
    margin-block-start: 0.25rem;
  }

  @media screen and (min-width: 750px) {
    .eva-arch-hero__stage {
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
      align-items: center;
      gap: clamp(1.5rem, 4vw, 3.5rem);
    }

    .eva-arch-hero__word--start {
      justify-self: end;
    }

    .eva-arch-hero__word--end {
      justify-self: start;
    }

    .eva-arch-hero__arch {
      width: min(32vw, 30rem);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:eva.sections.arch_hero",
  "class": "eva-arch-hero-section",
  "enabled_on": {
    "templates": ["index"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:eva.settings.image",
      "info": "t:eva.info.arch_image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:eva.settings.heading",
      "info": "t:eva.info.arch_heading",
      "default": "Silk, lace & mesh lingerie"
    },
    {
      "type": "text",
      "id": "word_start",
      "label": "t:eva.settings.word_start",
      "default": "Softly,"
    },
    {
      "type": "text",
      "id": "word_end",
      "label": "t:eva.settings.word_end",
      "default": "boldly."
    },
    {
      "type": "inline_richtext",
      "id": "text",
      "label": "t:eva.settings.text",
      "default": "Satin, lace and a single ribbon. Lingerie with a soft touch and a strong line."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:eva.settings.button_label",
      "default": "Shop the collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:eva.settings.button_link"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "t:eva.settings.color_scheme",
      "options": [
        { "value": "ivory", "label": "t:eva.options.ivory" },
        { "value": "blush", "label": "t:eva.options.blush" }
      ],
      "default": "ivory"
    },
    {
      "type": "header",
      "content": "t:eva.content.spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:eva.settings.padding_top",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:eva.settings.padding_bottom",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 96
    }
  ],
  "presets": [
    {
      "name": "t:eva.sections.arch_hero"
    }
  ]
}
{% endschema %}
