{%- liquid
  assign menu = section.settings.menu
  assign wordmark = section.settings.wordmark | default: shop.name

  assign cart_opens_drawer = false
  if settings.cart_type == 'drawer' and template.name != 'cart'
    assign cart_opens_drawer = true
  endif
-%}

{%- comment -%}
  Reuses Horizon's cart-icon (live cart count) and dialog-component, and opens the Eva search
  panel (#eva-search) and cart drawer (#eva-cart-drawer), so this header adds no JavaScript of its own. The id and
  data-sticky-state attribute keep `--header-height` consumers working.
{%- endcomment -%}
<script
  src="{{ 'cart-icon.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

<div
  id="header-component"
  class="eva-header eva-scheme-{{ section.settings.color_scheme }}"
  {% if section.settings.sticky %}
    data-sticky-state="active"
  {% endif %}
  style="--eva-logo-height: {{ settings.logo_height }}px; --eva-logo-height-mobile: {{ settings.logo_height_mobile }}px;"
>
  <div class="eva-header__inner eva-page">
    <div class="eva-header__start">
      <button
        type="button"
        class="eva-icon-button eva-header__menu-button"
        on:click="#eva-menu-drawer/showDialog"
        aria-haspopup="dialog"
        aria-controls="eva-menu-drawer"
        aria-label="{{ 'eva.header.open_menu' | t }}"
      >
        {%- render 'eva-icon', icon: 'menu' -%}
      </button>

      {%- if menu.links.size > 0 -%}
        <nav
          class="eva-header__nav"
          aria-label="{{ 'eva.header.main_navigation' | t }}"
        >
          <ul
            class="eva-header__menu"
            role="list"
          >
            {%- for link in menu.links -%}
              <li class="eva-header__item">
                {%- if link.links.size > 0 -%}
                  <details
                    class="eva-header__dropdown"
                    data-auto-close-details="desktop"
                  >
                    <summary class="eva-header__link">
                      {{- link.title | escape -}}
                      {%- render 'eva-icon', icon: 'chevron', class: 'eva-header__chevron' -%}
                    </summary>
                    <ul
                      class="eva-header__submenu eva-scheme-ivory"
                      role="list"
                    >
                      {%- for child_link in link.links -%}
                        <li>
                          <a
                            href="{{ child_link.url }}"
                            class="eva-header__sublink"
                            {% if child_link.current %}
                              aria-current="page"
                            {% endif %}
                          >
                            {{- child_link.title | escape -}}
                          </a>
                        </li>
                      {%- endfor -%}
                    </ul>
                  </details>
                {%- else -%}
                  <a
                    href="{{ link.url }}"
                    class="eva-header__link"
                    {% if link.current %}
                      aria-current="page"
                    {% endif %}
                  >
                    {{- link.title | escape -}}
                  </a>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        </nav>
      {%- endif -%}
    </div>

    <a
      href="{{ routes.root_url }}"
      class="eva-header__logo"
    >
      {%- if settings.logo != blank -%}
        {%- assign logo_alt = settings.logo.alt | default: shop.name -%}
        {{
          settings.logo
          | image_url: width: 600
          | image_tag:
            widths: '150, 300, 450, 600',
            sizes: '(min-width: 990px) 300px, 200px',
            alt: logo_alt,
            class: 'eva-header__logo-image',
            loading: 'eager'
        }}
      {%- else -%}
        <span class="eva-header__wordmark">{{ wordmark | escape }}</span>
      {%- endif -%}
    </a>

    <div class="eva-header__end">
      {%- if section.settings.show_search -%}
        <button
          type="button"
          class="eva-icon-button"
          on:click="#eva-search/showDialog"
          aria-controls="eva-search"
          aria-haspopup="dialog"
          aria-label="{{ 'eva.header.search' | t }}"
        >
          {%- render 'eva-icon', icon: 'search' -%}
        </button>
      {%- endif -%}

      {%- if shop.customer_accounts_enabled and section.settings.show_account -%}
        <a
          href="{{ routes.account_url }}"
          class="eva-icon-button eva-header__account"
          aria-label="{% if customer %}{{ 'eva.header.account' | t }}{% else %}{{ 'eva.header.log_in' | t }}{% endif %}"
        >
          {%- render 'eva-icon', icon: 'account' -%}
        </a>
      {%- endif -%}

      {%- capture cart_icon -%}
        <cart-icon class="eva-header__cart">
          {%- render 'eva-icon', icon: 'bag' -%}
          {%- render 'cart-bubble', limit: 100 -%}
        </cart-icon>
      {%- endcapture -%}

      {%- if cart_opens_drawer -%}
        <button
          type="button"
          class="eva-icon-button"
          on:click="#eva-cart-drawer/showDialog"
          aria-haspopup="dialog"
          aria-controls="eva-cart-drawer"
          aria-label="{{ 'eva.header.cart' | t }}"
          aria-describedby="cart-bubble-text"
        >
          {{- cart_icon -}}
        </button>
      {%- else -%}
        <a
          href="{{ routes.cart_url }}"
          class="eva-icon-button"
          aria-label="{{ 'eva.header.cart' | t }}"
          aria-describedby="cart-bubble-text"
        >
          {{- cart_icon -}}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

<dialog-component
  id="eva-menu-drawer"
  dialog-active-max-width="989"
>
  <dialog
    ref="dialog"
    class="eva-drawer eva-scheme-ivory"
    aria-labelledby="EvaMenuDrawerTitle"
    scroll-lock
  >
    <div class="eva-drawer__head">
      <h2
        id="EvaMenuDrawerTitle"
        class="eva-eyebrow"
      >
        {{- 'eva.header.menu' | t -}}
      </h2>
      <button
        type="button"
        class="eva-icon-button"
        on:click="dialog-component/closeDialog"
        aria-label="{{ 'eva.header.close_menu' | t }}"
      >
        {%- render 'eva-icon', icon: 'close' -%}
      </button>
    </div>

    {%- if menu.links.size > 0 -%}
      <nav aria-label="{{ 'eva.header.main_navigation' | t }}">
        <ul
          class="eva-drawer__menu"
          role="list"
        >
          {%- for link in menu.links -%}
            <li>
              {%- if link.links.size > 0 -%}
                <details class="eva-drawer__group">
                  <summary class="eva-drawer__link">
                    {{- link.title | escape -}}
                    {%- render 'eva-icon', icon: 'chevron', class: 'eva-header__chevron' -%}
                  </summary>
                  <ul
                    class="eva-drawer__submenu"
                    role="list"
                  >
                    {%- for child_link in link.links -%}
                      <li>
                        <a
                          href="{{ child_link.url }}"
                          class="eva-drawer__sublink"
                          {% if child_link.current %}
                            aria-current="page"
                          {% endif %}
                        >
                          {{- child_link.title | escape -}}
                        </a>
                      </li>
                    {%- endfor -%}
                  </ul>
                </details>
              {%- else -%}
                <a
                  href="{{ link.url }}"
                  class="eva-drawer__link"
                  {% if link.current %}
                    aria-current="page"
                  {% endif %}
                >
                  {{- link.title | escape -}}
                </a>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}

    <div class="eva-drawer__foot">
      {%- if shop.customer_accounts_enabled -%}
        <a
          href="{{ routes.account_url }}"
          class="eva-link"
        >
          {%- if customer -%}
            {{- 'eva.header.account' | t -}}
          {%- else -%}
            {{- 'eva.header.log_in' | t -}}
          {%- endif -%}
        </a>
      {%- endif -%}
      {%- render 'eva-localization', id_prefix: 'EvaDrawer' -%}
    </div>
  </dialog>
</dialog-component>

{% stylesheet %}
  :root {
    --header-height: var(--eva-header-height);
  }

  #header-group:has(.eva-header[data-sticky-state]) {
    display: contents;
  }

  .eva-header-section:has(> .eva-header[data-sticky-state]) {
    position: sticky;
    top: 0;
    z-index: var(--layer-menu-drawer);
  }

  .eva-header {
    border-block-end: 1px solid var(--eva-line);
  }

  .eva-header__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    min-height: var(--eva-header-height);
  }

  .eva-header__start,
  .eva-header__end {
    display: flex;
    align-items: center;
  }

  .eva-header__start {
    margin-inline-start: -0.75rem;
  }

  .eva-header__end {
    justify-content: flex-end;
    margin-inline-end: -0.75rem;
  }

  .eva-header__nav {
    display: none;
  }

  .eva-header__menu,
  .eva-header__submenu,
  .eva-drawer__menu,
  .eva-drawer__submenu {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .eva-header__menu {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.75rem;
  }

  .eva-header__item {
    position: relative;
  }

  .eva-header__link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    min-height: 2.75rem;
    font-family: var(--font-subheading--family);
    font-weight: var(--font-subheading--weight);
    font-size: 0.75rem;
    letter-spacing: var(--eva-tracking-nav);
    text-transform: uppercase;
    text-decoration: none;
    color: inherit;
    cursor: pointer;
    list-style: none;
  }

  .eva-header__link:hover,
  .eva-header__link[aria-current='page'] {
    text-decoration: underline;
    text-decoration-color: currentcolor;
    text-underline-offset: 0.5em;
  }

  .eva-header__chevron {
    width: 0.875rem;
    height: 0.875rem;
    transition: transform var(--eva-duration) var(--eva-ease);
  }

  details[open] > summary .eva-header__chevron {
    transform: rotate(180deg);
  }

  .eva-header__submenu {
    position: absolute;
    inset-block-start: 100%;
    inset-inline-start: -1.25rem;
    z-index: var(--layer-raised);
    min-width: 13rem;
    padding: 0.75rem 1.25rem;
    border: 1px solid var(--eva-line);
  }

  .eva-header__sublink,
  .eva-drawer__sublink {
    display: block;
    padding-block: 0.5rem;
    font-size: 0.875rem;
    color: inherit;
    text-decoration: none;
  }

  .eva-header__sublink:hover,
  .eva-drawer__sublink:hover {
    text-decoration: underline;
    text-decoration-color: currentcolor;
  }

  .eva-header__logo {
    display: block;
    color: inherit;
    text-decoration: none;
    text-align: center;
  }

  .eva-header__wordmark {
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: 1.625rem;
    line-height: 1;
    letter-spacing: 0.3em;
    margin-inline-end: -0.3em;
    text-transform: uppercase;
  }

  .eva-header__logo-image {
    width: auto;
    height: var(--eva-logo-height-mobile);
  }

  .eva-header__account {
    display: none;
  }

  .eva-header__cart {
    --cart-bubble-size: 1rem;

    position: relative;
    display: inline-flex;
  }

  .eva-header__cart .cart-bubble {
    position: absolute;
    inset-block-start: -0.375rem;
    inset-inline-end: -0.5rem;
    width: var(--cart-bubble-size);
  }

  @media screen and (min-width: 750px) {
    .eva-header__account {
      display: inline-flex;
    }
  }

  @media screen and (min-width: 990px) {
    .eva-header__menu-button {
      display: none;
    }

    .eva-header__start {
      margin-inline-start: 0;
    }

    .eva-header__nav {
      display: block;
    }

    .eva-header__logo-image {
      height: var(--eva-logo-height);
    }
  }

  /* Mobile menu drawer (the drawer shell lives in eva-base.css) */

  .eva-drawer__menu > li {
    border-block-end: 1px solid var(--eva-line);
  }

  .eva-drawer__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 3.5rem;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: 1.5rem;
    color: inherit;
    text-decoration: none;
    cursor: pointer;
    list-style: none;
  }

  .eva-drawer__link::-webkit-details-marker,
  .eva-header__link::-webkit-details-marker {
    display: none;
  }

  .eva-drawer__submenu {
    padding-block-end: 1rem;
  }

  .eva-drawer__foot {
    display: grid;
    gap: 1.5rem;
    padding-block-start: 2rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:eva.sections.header",
  "tag": "header",
  "class": "header-section eva-header-section",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:eva.settings.menu",
      "default": "main-menu"
    },
    {
      "type": "text",
      "id": "wordmark",
      "label": "t:eva.settings.wordmark",
      "info": "t:eva.info.wordmark"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "t:eva.settings.show_search",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "t:eva.settings.show_account",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "sticky",
      "label": "t:eva.settings.sticky_header",
      "default": true
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "t:eva.settings.color_scheme",
      "options": [
        { "value": "ivory", "label": "t:eva.options.ivory" },
        { "value": "blush", "label": "t:eva.options.blush" },
        { "value": "plum", "label": "t:eva.options.plum" },
        { "value": "charcoal", "label": "t:eva.options.charcoal" }
      ],
      "default": "ivory"
    }
  ],
  "presets": [
    {
      "name": "t:eva.sections.header"
    }
  ]
}
{% endschema %}
