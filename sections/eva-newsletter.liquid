{%- liquid
  assign form_id = 'EvaNewsletter-' | append: section.id
  assign input_id = 'EvaNewsletterEmail-' | append: section.id
  assign message_id = 'EvaNewsletterMessage-' | append: section.id
-%}

<div
  class="eva-newsletter eva-section eva-scheme-{{ section.settings.color_scheme }}"
  style="--eva-pt: {{ section.settings.padding_top }}px; --eva-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="eva-page eva-newsletter__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="eva-heading eva-heading--xs">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <p class="eva-body eva-newsletter__text">{{ section.settings.text }}</p>
    {%- endif -%}

    {%- form 'customer', id: form_id, class: 'eva-newsletter__form' -%}
      <input
        type="hidden"
        name="contact[tags]"
        value="newsletter"
      >
      <label
        for="{{ input_id }}"
        class="visually-hidden"
      >
        {{- 'eva.newsletter.email_label' | t -}}
      </label>
      <input
        id="{{ input_id }}"
        class="eva-newsletter__input"
        type="email"
        name="contact[email]"
        autocomplete="email"
        autocapitalize="off"
        spellcheck="false"
        required
        placeholder="{{ section.settings.placeholder | escape }}"
        {% if form.errors %}
          aria-invalid="true"
          aria-describedby="{{ message_id }}"
        {% endif %}
      >
      <button
        type="submit"
        class="eva-button eva-button--primary eva-newsletter__button"
      >
        {{- section.settings.button_label | escape -}}
      </button>

      {%- if form.posted_successfully? -%}
        <p
          id="{{ message_id }}"
          class="eva-newsletter__message"
          role="status"
        >
          {{- 'eva.newsletter.success' | t -}}
        </p>
      {%- elsif form.errors -%}
        <p
          id="{{ message_id }}"
          class="eva-newsletter__message"
          role="alert"
        >
          {{- 'eva.newsletter.error' | t -}}
        </p>
      {%- endif -%}
    {%- endform -%}
  </div>
</div>

{% stylesheet %}
  .eva-newsletter__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    text-align: center;
  }

  .eva-newsletter__text {
    color: var(--eva-muted, currentcolor);
  }

  .eva-newsletter__form {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    width: min(100%, 28.5rem);
    margin-block-start: 1rem;
  }

  .eva-newsletter__input {
    flex: 1 1 14rem;
    min-width: 0;
    min-height: 2.875rem;
    padding-inline: 1rem;
    border: 1px solid var(--eva-border);
    border-radius: 0;
    background-color: #fff;
    color: var(--eva-charcoal);
    font-family: var(--font-body--family);
    font-weight: var(--font-body--weight);
    font-size: 0.875rem;
  }

  .eva-newsletter__input::placeholder {
    color: var(--eva-grey);
    opacity: 1;
  }

  .eva-newsletter__input:focus-visible {
    outline: 2px solid var(--eva-charcoal);
    outline-offset: -2px;
  }

  .eva-newsletter__button {
    flex: 0 0 auto;
  }

  .eva-newsletter__message {
    flex-basis: 100%;
    margin: 0.75rem 0 0;
    font-size: 0.8125rem;
  }

  @media screen and (max-width: 479px) {
    .eva-newsletter__button {
      flex: 1 1 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:eva.sections.newsletter",
  "class": "eva-newsletter-section",
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "t:eva.content.newsletter_info"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:eva.settings.heading",
      "default": "Newsletter"
    },
    {
      "type": "inline_richtext",
      "id": "text",
      "label": "t:eva.settings.text",
      "default": "Early access to new drops and private offers."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "t:eva.settings.placeholder",
      "default": "Your email"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:eva.settings.button_label",
      "default": "Subscribe"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "t:eva.settings.color_scheme",
      "options": [
        { "value": "ivory", "label": "t:eva.options.ivory" },
        { "value": "blush", "label": "t:eva.options.blush" }
      ],
      "default": "ivory"
    },
    {
      "type": "header",
      "content": "t:eva.content.spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:eva.settings.padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 88
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:eva.settings.padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 88
    }
  ],
  "presets": [
    {
      "name": "t:eva.sections.newsletter"
    }
  ]
}
{% endschema %}
