{%- liquid
  assign form_id = 'EvaCartForm-' | append: section.id
  assign summary_id = 'EvaCartSummary-' | append: section.id

  # Applied discount codes, from cart-level and line-level discount applications (as Horizon does).
  assign discount_codes = cart.cart_level_discount_applications | where: 'type', 'discount_code' | map: 'title'
  for item in cart.items
    for allocation in item.line_level_discount_allocations
      if allocation.discount_application.type == 'discount_code'
        assign discount_codes = item.line_level_discount_allocations | slice: forloop.index0 | map: 'discount_application' | map: 'title' | concat: discount_codes
      endif
    endfor
  endfor
  assign discount_codes = discount_codes | uniq
-%}

<script
  src="{{ 'eva-cart.js' | asset_url }}"
  type="module"
></script>

<div
  class="eva-cart-section eva-section eva-scheme-{{ section.settings.color_scheme }}"
  style="--eva-pt: {{ section.settings.padding_top }}px; --eva-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="eva-page">
    <eva-cart
      class="eva-cart"
      data-section-id="{{ section.id }}"
      data-label-updated="{{ 'eva.cart.updated' | t | escape }}"
      data-label-error="{{ 'eva.cart.update_error' | t | escape }}"
      data-label-discount-error="{{ 'eva.cart.discount_error' | t | escape }}"
      data-label-shipping-discount="{{ 'eva.cart.shipping_discount' | t | escape }}"
      data-label-quantity-capped="{{ 'eva.cart.quantity_capped' | t | escape }}"
    >
      <div class="eva-cart__header">
        <h1
          class="eva-heading eva-heading--md"
          tabindex="-1"
          data-cart-heading
        >
          {{- section.settings.heading | escape -}}
        </h1>
        {%- if cart.item_count > 0 -%}
          <p class="eva-caption">{{ 'eva.cart.item_count' | t: count: cart.item_count }}</p>
        {%- endif -%}
      </div>

      {%- if cart.item_count == 0 -%}
        <div class="eva-cart__empty">
          <p class="eva-heading eva-heading--xs">{{ 'eva.cart.empty' | t }}</p>
          <a
            href="{{ section.settings.continue_link | default: routes.all_products_collection_url }}"
            class="eva-button eva-button--outline"
          >
            {{- 'eva.cart.continue_shopping' | t -}}
          </a>
          {%- if shop.customer_accounts_enabled and customer == nil -%}
            <p class="eva-caption">
              {{ 'eva.cart.login_html' | t: link: routes.account_login_url }}
            </p>
          {%- endif -%}
        </div>
      {%- else -%}
        <div class="eva-cart__grid">
          {%- form 'cart', cart, id: form_id, class: 'eva-cart__form', novalidate: 'novalidate' -%}
            <h2 class="visually-hidden">{{ 'eva.cart.items_heading' | t }}</h2>
            <ul
              class="eva-cart__lines"
              role="list"
            >
              {%- for item in cart.items -%}
                {%- render 'eva-cart-line', item: item, index: forloop.index, id_prefix: section.id -%}
              {%- endfor -%}
            </ul>

            {%- comment -%} Without JavaScript, quantity changes are applied with this button. {%- endcomment -%}
            <button
              type="submit"
              name="update"
              class="eva-button eva-button--outline eva-cart__update"
            >
              {{- 'eva.cart.update' | t -}}
            </button>
          {%- endform -%}

          <aside
            class="eva-cart__summary eva-scheme-blush"
            aria-labelledby="{{ summary_id }}"
          >
            <h2
              id="{{ summary_id }}"
              class="eva-eyebrow"
            >
              {{- 'eva.cart.summary' | t -}}
            </h2>

            <dl class="eva-cart__totals">
              <div class="eva-cart__row">
                <dt>{{ 'eva.cart.subtotal' | t }}</dt>
                <dd>{{ cart.items_subtotal_price | money }}</dd>
              </div>
              {%- for discount in cart.cart_level_discount_applications -%}
                <div class="eva-cart__row">
                  <dt>{{ discount.title | escape }}</dt>
                  <dd>−{{ discount.total_allocated_amount | money }}</dd>
                </div>
              {%- endfor -%}
              <div class="eva-cart__row eva-cart__row--total">
                <dt>{{ 'eva.cart.total' | t }}</dt>
                <dd>
                  {%- if settings.currency_code_enabled_cart_total -%}
                    {{ cart.total_price | money_with_currency }}
                  {%- else -%}
                    {{ cart.total_price | money }}
                  {%- endif -%}
                </dd>
              </div>
            </dl>

            <p class="eva-caption">
              {%- if shop.taxes_included -%}
                {{ 'eva.product.tax_included' | t }}
              {%- else -%}
                {{ 'eva.product.tax_excluded' | t }}
              {%- endif %}
              {% if shop.shipping_policy.body != blank -%}
                {{ 'eva.product.shipping_at_checkout_html' | t: link: shop.shipping_policy.url }}
              {%- else -%}
                {{ 'eva.product.shipping_at_checkout' | t }}
              {%- endif -%}
            </p>

            {%- if settings.show_add_discount_code -%}
              <div class="eva-cart__discounts">
                {%- if discount_codes.size > 0 -%}
                  <ul
                    class="eva-cart__codes"
                    role="list"
                  >
                    {%- for code in discount_codes -%}
                      <li>
                        <button
                          type="button"
                          class="eva-chip"
                          data-remove-code="{{ code | escape }}"
                          data-focus-key="code-{{ code | handleize }}"
                        >
                          {{- code | escape -}}
                          <span class="visually-hidden">{{ 'eva.cart.remove_code' | t }}</span>
                          {%- render 'eva-icon', icon: 'close', class: 'eva-cart__code-icon' -%}
                        </button>
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}

                <form
                  class="eva-cart__discount-form"
                  data-discount-form
                  data-codes="{{ discount_codes | join: ',' | escape }}"
                >
                  <label
                    for="{{ summary_id }}-Discount"
                    class="eva-caption"
                  >
                    {{- 'eva.cart.discount_label' | t -}}
                  </label>
                  <div class="eva-cart__discount-row">
                    <input
                      id="{{ summary_id }}-Discount"
                      class="eva-cart__input"
                      type="text"
                      name="discount"
                      autocomplete="off"
                      autocapitalize="characters"
                      spellcheck="false"
                      data-focus-key="discount-input"
                    >
                    <button
                      type="submit"
                      class="eva-button eva-button--outline"
                    >
                      {{- 'eva.cart.apply' | t -}}
                    </button>
                  </div>
                  <p
                    class="eva-cart__discount-error"
                    role="alert"
                    data-discount-error
                    hidden
                  ></p>
                </form>
              </div>
            {%- endif -%}

            {%- if settings.show_cart_note -%}
              <details
                class="eva-cart__note"
                {% if cart.note != blank or settings.cart_note_open_by_default %}
                  open
                {% endif %}
              >
                <summary class="eva-caption">{{ 'eva.cart.note' | t }}</summary>
                <label
                  for="{{ summary_id }}-Note"
                  class="visually-hidden"
                >
                  {{- 'eva.cart.note' | t -}}
                </label>
                <textarea
                  id="{{ summary_id }}-Note"
                  class="eva-cart__input"
                  name="note"
                  form="{{ form_id }}"
                  data-focus-key="note"
                  rows="3"
                >
                  {{- cart.note -}}
                </textarea>
              </details>
            {%- endif -%}

            <button
              type="submit"
              name="checkout"
              form="{{ form_id }}"
              class="eva-button eva-button--primary eva-cart__checkout"
            >
              {{- 'eva.cart.checkout' | t -}}
            </button>

            {%- if settings.show_accelerated_checkout_buttons and additional_checkout_buttons -%}
              <div class="eva-cart__accelerated">{{ content_for_additional_checkout_buttons }}</div>
            {%- endif -%}

            {%- if section.settings.info_text != blank -%}
              <p class="eva-caption eva-cart__info">{{ section.settings.info_text | escape }}</p>
            {%- endif -%}
          </aside>
        </div>
      {%- endif -%}
    </eva-cart>

    <p
      class="visually-hidden"
      role="status"
      data-cart-status
    ></p>
  </div>
</div>

{% stylesheet %}
  .eva-cart__header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1rem;
    margin-block-end: clamp(1.5rem, 4vw, 2.5rem);
  }

  .eva-cart__header [data-cart-heading]:focus {
    outline: none;
  }

  .eva-cart__empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    padding-block: 3rem 1rem;
    text-align: center;
  }

  .eva-cart__empty a:not(.eva-button) {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: currentcolor;
  }

  .eva-cart__grid {
    display: grid;
    gap: 2.5rem;
    align-items: start;
  }

  .eva-cart[aria-busy='true'] .eva-cart__grid {
    opacity: 0.6;
    transition: opacity 0.2s;
  }

  .eva-cart__codes {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* The discount form needs the script; quantities fall back to the Update bag button. */
  eva-cart:not(:defined) .eva-cart__discounts {
    display: none;
  }

  eva-cart:defined .eva-cart__update {
    display: none;
  }

  .eva-cart__update {
    margin-block-start: 1.5rem;
  }

  /* Summary panel */

  .eva-cart__summary {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: clamp(1.5rem, 3vw, 2.25rem);
  }

  .eva-cart__totals {
    display: grid;
    gap: 0.75rem;
    margin: 0;
  }

  .eva-cart__row {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.875rem;
  }

  .eva-cart__row dd {
    margin: 0;
  }

  .eva-cart__row--total {
    padding-block-start: 0.75rem;
    border-block-start: 1px solid var(--eva-line);
    font-family: var(--font-subheading--family);
    font-weight: var(--font-subheading--weight);
    font-size: 1.0625rem;
  }

  .eva-cart__codes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block-end: 0.75rem;
  }

  .eva-cart__code-icon {
    width: 0.75rem;
    height: 0.75rem;
  }

  .eva-cart__discount-form {
    display: grid;
    gap: 0.375rem;
  }

  .eva-cart__discount-error {
    margin: 0.5rem 0 0;
    font-size: 0.8125rem;
    color: var(--eva-wine);
  }

  .eva-cart__discount-row {
    display: flex;
    gap: 0.5rem;
  }

  .eva-cart__input {
    flex: 1;
    min-width: 0;
    min-height: 2.875rem;
    width: 100%;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--eva-border);
    border-radius: 0;
    background-color: #fff;
    color: var(--eva-charcoal);
    font-family: var(--font-body--family);
    font-size: 0.875rem;
  }

  .eva-cart__note summary {
    cursor: pointer;
    margin-block-end: 0.5rem;
  }

  .eva-cart__checkout {
    width: 100%;
    min-height: 3.125rem;
  }

  .eva-cart__info {
    text-align: center;
  }

  @media screen and (min-width: 990px) {
    .eva-cart__grid {
      grid-template-columns: minmax(0, 1fr) minmax(18rem, 24rem);
      gap: clamp(2.5rem, 5vw, 4.5rem);
    }

    .eva-cart__summary {
      position: sticky;
      inset-block-start: calc(var(--header-height, 0px) + 1.5rem);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:eva.sections.main_cart",
  "class": "eva-main-cart-section",
  "enabled_on": {
    "templates": ["cart"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "t:eva.content.cart_info"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:eva.settings.heading",
      "default": "Your bag"
    },
    {
      "type": "text",
      "id": "info_text",
      "label": "t:eva.settings.info_text",
      "default": "Free returns within 14 days"
    },
    {
      "type": "url",
      "id": "continue_link",
      "label": "t:eva.settings.continue_link"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "t:eva.settings.color_scheme",
      "options": [
        { "value": "ivory", "label": "t:eva.options.ivory" },
        { "value": "blush", "label": "t:eva.options.blush" }
      ],
      "default": "ivory"
    },
    {
      "type": "header",
      "content": "t:eva.content.spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:eva.settings.padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:eva.settings.padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 72
    }
  ]
}
{% endschema %}
