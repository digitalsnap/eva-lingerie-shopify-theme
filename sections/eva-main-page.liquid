<div
  class="eva-page-content eva-section eva-scheme-{{ section.settings.color_scheme }}"
  style="--eva-pt: {{ section.settings.padding_top }}px; --eva-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="eva-page eva-page-content__inner eva-page-content__inner--{{ section.settings.width }}">
    {%- if section.settings.eyebrow != blank -%}
      <p class="eva-eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    <h1 class="eva-heading eva-heading--md">{{ page.title | escape }}</h1>
    {%- if page.content != blank -%}
      <div class="eva-body eva-rte eva-page-content__body">{{ page.content }}</div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .eva-page-content__inner {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .eva-page-content__inner--narrow {
    max-inline-size: 44rem;
  }

  .eva-page-content__inner--wide {
    max-inline-size: 64rem;
  }

  .eva-page-content__body {
    font-size: 0.9375rem;
  }

  .eva-page-content__body :is(h2, h3, h4) {
    margin-block: 2em 0.6em;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    line-height: 1.2;
  }

  .eva-page-content__body h2 {
    font-size: 1.75rem;
  }

  .eva-page-content__body h3 {
    font-size: 1.375rem;
  }

  .eva-page-content__body a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: currentcolor;
    text-underline-offset: 0.2em;
  }

  .eva-page-content__body img {
    height: auto;
  }

  /* Size guides and care tables are common page content. */
  .eva-page-content__body table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
  }

  .eva-page-content__body :is(th, td) {
    padding: 0.625rem 0.5rem;
    border-block-end: 1px solid var(--eva-line);
    text-align: start;
  }

  .eva-page-content__body th {
    font-family: var(--font-subheading--family);
    font-weight: var(--font-subheading--weight);
    font-size: 0.6875rem;
    letter-spacing: var(--eva-tracking-label);
    text-transform: uppercase;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:eva.sections.main_page",
  "class": "eva-main-page-section",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:eva.settings.eyebrow"
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:eva.settings.content_width",
      "options": [
        { "value": "narrow", "label": "t:eva.options.narrow" },
        { "value": "wide", "label": "t:eva.options.wide" }
      ],
      "default": "narrow"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "t:eva.settings.color_scheme",
      "options": [
        { "value": "ivory", "label": "t:eva.options.ivory" },
        { "value": "blush", "label": "t:eva.options.blush" }
      ],
      "default": "ivory"
    },
    {
      "type": "header",
      "content": "t:eva.content.spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:eva.settings.padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:eva.settings.padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 72
    }
  ]
}
{% endschema %}
