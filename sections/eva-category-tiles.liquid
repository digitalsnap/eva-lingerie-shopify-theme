{%- assign heading_id = 'EvaTilesHeading-' | append: section.id -%}

<div
  class="eva-tiles eva-section eva-scheme-{{ section.settings.color_scheme }}"
  style="--eva-pt: {{ section.settings.padding_top }}px; --eva-pb: {{ section.settings.padding_bottom }}px; --eva-tile-ratio: {{ section.settings.tile_ratio }}; --eva-tile-count: {{ section.blocks.size | at_least: 1 }};"
>
  <div class="eva-page">
    {%- if section.settings.heading != blank -%}
      <h2
        id="{{ heading_id }}"
        class="eva-heading eva-heading--sm eva-tiles__heading{% if section.settings.hide_heading %} visually-hidden{% endif %}"
      >
        {{- section.settings.heading | escape -}}
      </h2>
    {%- endif -%}

    <ul
      class="eva-tiles__list"
      role="list"
      {% if section.settings.heading != blank %}
        aria-labelledby="{{ heading_id }}"
      {% endif %}
    >
      {% content_for 'blocks' %}
    </ul>
  </div>
</div>

{% stylesheet %}
  .eva-tiles__heading {
    margin-block-end: 1.5rem;
    text-align: center;
  }

  .eva-tiles__list {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 78%;
    gap: 0.75rem;
    margin: 0 calc(var(--eva-gutter) * -1);
    padding: 0 var(--eva-gutter);
    list-style: none;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--eva-gutter);
    scrollbar-width: none;
  }

  .eva-tiles__list::-webkit-scrollbar {
    display: none;
  }

  .eva-tile {
    scroll-snap-align: start;
  }

  @media screen and (min-width: 750px) {
    .eva-tiles__list {
      grid-auto-flow: row;
      grid-template-columns: repeat(var(--eva-tile-count), minmax(0, 1fr));
      gap: 1rem;
      margin: 0;
      padding: 0;
      overflow: visible;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:eva.sections.category_tiles",
  "class": "eva-tiles-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 4,
  "blocks": [
    {
      "type": "_eva-category-tile"
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:eva.settings.heading",
      "default": "Shop by category"
    },
    {
      "type": "checkbox",
      "id": "hide_heading",
      "label": "t:eva.settings.hide_heading",
      "info": "t:eva.info.hide_heading",
      "default": true
    },
    {
      "type": "select",
      "id": "tile_ratio",
      "label": "t:eva.settings.image_ratio",
      "options": [
        { "value": "4 / 5", "label": "4:5" },
        { "value": "3 / 4", "label": "3:4" },
        { "value": "1 / 1", "label": "1:1" }
      ],
      "default": "4 / 5"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "t:eva.settings.color_scheme",
      "options": [
        { "value": "ivory", "label": "t:eva.options.ivory" },
        { "value": "blush", "label": "t:eva.options.blush" },
        { "value": "plum", "label": "t:eva.options.plum" },
        { "value": "charcoal", "label": "t:eva.options.charcoal" }
      ],
      "default": "ivory"
    },
    {
      "type": "header",
      "content": "t:eva.content.spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:eva.settings.padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:eva.settings.padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "t:eva.sections.category_tiles",
      "blocks": [
        { "type": "_eva-category-tile", "settings": { "label": "Bras" } },
        { "type": "_eva-category-tile", "settings": { "label": "Sets" } },
        { "type": "_eva-category-tile", "settings": { "label": "Sleep & Lounge" } }
      ]
    }
  ]
}
{% endschema %}
