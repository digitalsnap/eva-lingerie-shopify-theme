<div
  class="eva-not-found eva-section eva-scheme-{{ section.settings.color_scheme }}"
  style="--eva-pt: {{ section.settings.padding_top }}px; --eva-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="eva-page eva-not-found__inner">
    <p class="eva-eyebrow">{{ 'eva.not_found.eyebrow' | t }}</p>
    <h1 class="eva-heading eva-heading--lg">{{ section.settings.heading | escape }}</h1>
    {%- if section.settings.text != blank -%}
      <p class="eva-body eva-not-found__text">{{ section.settings.text }}</p>
    {%- endif -%}
    {%- if section.settings.show_search -%}
      {%- render 'eva-search-form', id_prefix: 'EvaNotFoundSearch' -%}
    {%- endif -%}
    <a
      href="{{ section.settings.button_link | default: routes.all_products_collection_url }}"
      class="eva-link"
    >
      {{- section.settings.button_label | escape -}}
    </a>
  </div>
</div>

{% stylesheet %}
  .eva-not-found__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    text-align: center;
  }

  .eva-not-found__text {
    max-inline-size: 32rem;
    color: var(--eva-muted);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:eva.sections.main_404",
  "class": "eva-main-404-section",
  "enabled_on": {
    "templates": ["404"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:eva.settings.heading",
      "default": "This page has slipped away"
    },
    {
      "type": "inline_richtext",
      "id": "text",
      "label": "t:eva.settings.text",
      "default": "The link may be old or mistyped. Try a search, or continue to the shop."
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "t:eva.settings.show_search",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:eva.settings.link_label",
      "default": "Continue shopping"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:eva.settings.link"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "t:eva.settings.color_scheme",
      "options": [
        { "value": "ivory", "label": "t:eva.options.ivory" },
        { "value": "blush", "label": "t:eva.options.blush" }
      ],
      "default": "ivory"
    },
    {
      "type": "header",
      "content": "t:eva.content.spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:eva.settings.padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:eva.settings.padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ]
}
{% endschema %}
