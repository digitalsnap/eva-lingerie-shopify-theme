{%- assign numerals = 'I,II,III,IV' | split: ',' -%}

{%- comment -%}
  A quiet strip of short notes (what the pieces are made of, fit help, the welcome offer), numbered
  in the margin rather than dressed up as icon cards. A solid ground, so the ribbon passes behind it.
{%- endcomment -%}
<div
  class="eva-notes eva-section eva-section--solid eva-scheme-{{ section.settings.color_scheme }}"
  style="--eva-pt: {{ section.settings.padding_top }}px; --eva-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="eva-page">
    <ol
      class="eva-notes__list"
      role="list"
      {% if section.settings.heading != blank %}
        aria-label="{{ section.settings.heading | escape }}"
      {% endif %}
    >
      {%- for block in section.blocks -%}
        <li
          class="eva-notes__item"
          {{ block.shopify_attributes }}
        >
          <span
            class="eva-notes__numeral"
            aria-hidden="true"
          >
            {{- numerals[forloop.index0] -}}
          </span>
          {%- if block.settings.link != blank -%}
            <a
              class="eva-notes__text eva-notes__text--link"
              href="{{ block.settings.link }}"
            >
              {{- block.settings.text | strip_html -}}
            </a>
          {%- else -%}
            <p class="eva-notes__text">{{ block.settings.text }}</p>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ol>
  </div>
</div>

{% stylesheet %}
  .eva-notes {
    border-block: 1px solid var(--eva-line);
  }

  .eva-notes__list {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .eva-notes__item {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding-block: 1.25rem;
  }

  .eva-notes__item + .eva-notes__item {
    border-block-start: 1px solid var(--eva-line);
  }

  .eva-notes__numeral {
    flex: none;
    min-inline-size: 1.75rem;
    font-family: var(--font-subheading--family);
    font-weight: var(--font-subheading--weight);
    font-size: 0.75rem;
    letter-spacing: var(--eva-tracking-label);
    color: var(--eva-eyebrow);
  }

  .eva-notes__text {
    margin: 0;
    font-family: var(--font-accent--family);
    font-style: italic;
    font-weight: var(--font-accent--weight);
    font-size: clamp(1.25rem, 1rem + 0.6vw, 1.5rem);
    line-height: 1.3;
    color: inherit;
    text-decoration: none;
  }

  .eva-notes__text--link {
    display: inline-flex;
    min-block-size: 2.75rem;
    align-items: center;
    background-image: linear-gradient(currentcolor, currentcolor);
    background-position: 0 85%;
    background-size: 0 1px;
    background-repeat: no-repeat;
    transition: background-size 500ms var(--eva-ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .eva-notes__text--link:hover {
      background-size: 100% 1px;
    }
  }

  @media screen and (min-width: 750px) {
    .eva-notes__list {
      grid-auto-flow: column;
      grid-auto-columns: minmax(0, 1fr);
    }

    .eva-notes__item {
      justify-content: center;
      padding-inline: clamp(1rem, 3vw, 2.5rem);
    }

    .eva-notes__item + .eva-notes__item {
      border-block-start: 0;
      border-inline-start: 1px solid var(--eva-line);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:eva.sections.notes",
  "class": "eva-notes-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:eva.settings.heading",
      "info": "t:eva.info.notes_heading",
      "default": "Why Eva"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "t:eva.settings.color_scheme",
      "options": [
        { "value": "ivory", "label": "t:eva.options.ivory" },
        { "value": "blush", "label": "t:eva.options.blush" }
      ],
      "default": "ivory"
    },
    {
      "type": "header",
      "content": "t:eva.content.spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:eva.settings.padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:eva.settings.padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "note",
      "name": "t:eva.blocks.note",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "t:eva.settings.text",
          "default": "Silk, lace and mesh, chosen for how they feel first"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:eva.settings.link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:eva.sections.notes",
      "blocks": [
        {
          "type": "note",
          "settings": {
            "text": "Silk, lace and mesh, chosen for how they feel first"
          }
        },
        {
          "type": "note",
          "settings": {
            "text": "A size guide in cm and inches for every style"
          }
        },
        {
          "type": "note",
          "settings": {
            "text": "10% off your first order when you join the list"
          }
        }
      ]
    }
  ]
}
{% endschema %}
