{%- liquid
  assign columns = section.settings.columns | plus: 0
  assign card_vw = 100 | divided_by: columns
  assign sizes = '(min-width: 990px) ' | append: card_vw | append: 'vw, 50vw'
-%}

<div
  class="eva-collections eva-section eva-scheme-{{ section.settings.color_scheme }}"
  style="--eva-pt: {{ section.settings.padding_top }}px; --eva-pb: {{ section.settings.padding_bottom }}px; --eva-columns: {{ columns }}; --eva-tile-ratio: {{ section.settings.tile_ratio }};"
>
  <div class="eva-page">
    <h1 class="eva-heading eva-heading--md eva-collections__heading">{{ section.settings.heading | escape }}</h1>

    {%- paginate collections by section.settings.per_page -%}
      <ul
        class="eva-collections__grid"
        role="list"
      >
        {%- for collection in collections -%}
          {%- liquid
            assign tile_loading = 'lazy'
            if forloop.index <= columns
              assign tile_loading = 'eager'
            endif
          -%}
          <li>
            {%- render 'eva-collection-tile',
              url: collection.url,
              label: collection.title,
              image: collection.featured_image,
              sizes: sizes,
              loading: tile_loading
            -%}
          </li>
        {%- endfor -%}
      </ul>

      <div class="eva-collections__pagination">
        {%- render 'eva-pagination', paginate: paginate -%}
      </div>
    {%- endpaginate -%}
  </div>
</div>

{% stylesheet %}
  .eva-collections__heading {
    margin-block-end: clamp(2rem, 5vw, 3rem);
    text-align: center;
  }

  .eva-collections__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .eva-collections__pagination {
    margin-block-start: clamp(2.5rem, 5vw, 3.5rem);
  }

  @media screen and (min-width: 990px) {
    .eva-collections__grid {
      grid-template-columns: repeat(var(--eva-columns, 3), minmax(0, 1fr));
      gap: 1rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:eva.sections.main_list_collections",
  "class": "eva-main-list-collections-section",
  "enabled_on": {
    "templates": ["list-collections"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:eva.settings.heading",
      "default": "Collections"
    },
    {
      "type": "range",
      "id": "per_page",
      "label": "t:eva.settings.collections_per_page",
      "min": 6,
      "max": 48,
      "step": 3,
      "default": 24
    },
    {
      "type": "select",
      "id": "columns",
      "label": "t:eva.settings.columns_desktop",
      "options": [
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "3"
    },
    {
      "type": "select",
      "id": "tile_ratio",
      "label": "t:eva.settings.image_ratio",
      "options": [
        { "value": "4 / 5", "label": "4:5" },
        { "value": "3 / 4", "label": "3:4" },
        { "value": "1 / 1", "label": "1:1" }
      ],
      "default": "4 / 5"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "t:eva.settings.color_scheme",
      "options": [
        { "value": "ivory", "label": "t:eva.options.ivory" },
        { "value": "blush", "label": "t:eva.options.blush" }
      ],
      "default": "ivory"
    },
    {
      "type": "header",
      "content": "t:eva.content.spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:eva.settings.padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:eva.settings.padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 96
    }
  ]
}
{% endschema %}
