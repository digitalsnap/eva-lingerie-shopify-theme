{%- liquid
  assign image = section.settings.image
  assign form_id = 'EvaPasswordSignup-' | append: section.id
  assign input_id = 'EvaPasswordEmail-' | append: section.id
  assign message_id = 'EvaPasswordMessage-' | append: section.id
  assign wordmark = section.settings.wordmark | default: shop.name
-%}

<div
  class="eva-password eva-scheme-{{ section.settings.color_scheme }}{% if image != blank %} eva-on-media-{{ section.settings.media_text }}{% endif %}"
  style="--eva-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"
>
  {%- if image != blank -%}
    <div class="eva-password__media">
      {{
        image
        | image_url: width: 3200
        | image_tag:
          widths: '375, 750, 1100, 1500, 2200, 3200',
          sizes: '100vw',
          loading: 'eager',
          fetchpriority: 'high',
          preload: true,
          alt: ''
      }}
    </div>
  {%- endif -%}

  <div class="eva-page eva-password__inner">
    <p class="eva-password__logo">
      {%- if settings.logo != blank -%}
        {{
          settings.logo
          | image_url: width: 600
          | image_tag: widths: '150, 300, 450, 600', sizes: '200px', alt: shop.name, class: 'eva-password__logo-image'
        }}
      {%- else -%}
        {{ wordmark | escape }}
      {%- endif -%}
    </p>

    {%- if section.settings.eyebrow != blank -%}
      <p class="eva-eyebrow eva-password__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}

    <h1 class="eva-heading eva-heading--lg eva-password__heading">{{ section.settings.heading }}</h1>

    {%- if section.settings.text != blank -%}
      <div class="eva-body eva-rte eva-password__text">{{ section.settings.text }}</div>
    {%- elsif shop.password_message != blank -%}
      <p class="eva-body eva-password__text">{{ shop.password_message | escape }}</p>
    {%- endif -%}

    {%- if section.settings.show_newsletter -%}
      {%- form 'customer', id: form_id, class: 'eva-password__form' -%}
        <input
          type="hidden"
          name="contact[tags]"
          value="newsletter, prelaunch"
        >
        <label
          for="{{ input_id }}"
          class="visually-hidden"
        >
          {{- 'eva.newsletter.email_label' | t -}}
        </label>
        <input
          id="{{ input_id }}"
          class="eva-password__input"
          type="email"
          name="contact[email]"
          autocomplete="email"
          autocapitalize="off"
          spellcheck="false"
          required
          placeholder="{{ section.settings.placeholder | escape }}"
          {% if form.errors %}
            aria-invalid="true"
            aria-describedby="{{ message_id }}"
          {% endif %}
        >
        <button
          type="submit"
          class="eva-button eva-button--primary"
        >
          {{- section.settings.button_label | escape -}}
        </button>
        {%- if form.posted_successfully? -%}
          <p
            id="{{ message_id }}"
            class="eva-password__message"
            role="status"
          >
            {{- 'eva.password.signup_success' | t -}}
          </p>
        {%- elsif form.errors -%}
          <p
            id="{{ message_id }}"
            class="eva-password__message"
            role="alert"
          >
            {{- 'eva.newsletter.error' | t -}}
          </p>
        {%- endif -%}
      {%- endform -%}
    {%- endif -%}

    <button
      type="button"
      class="eva-link eva-password__enter"
      on:click="#password-form/showDialog"
      aria-haspopup="dialog"
      aria-controls="password-form"
    >
      {{- 'eva.password.enter' | t -}}
    </button>
  </div>
</div>

{% stylesheet %}
  .eva-password {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    min-height: 100svh;
    text-align: center;
  }

  .eva-password__media {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
  }

  .eva-password__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .eva-password__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background-color: var(--eva-veil, var(--eva-bg));
    opacity: max(var(--eva-overlay, 0), var(--eva-overlay-min, 0));
  }

  .eva-password__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    padding-block: clamp(4rem, 10vw, 7rem);
  }

  .eva-password__logo {
    margin: 0 0 clamp(1.5rem, 5vw, 3rem);
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: 2rem;
    line-height: 1;
    letter-spacing: 0.3em;
    margin-inline-end: -0.3em;
    text-transform: uppercase;
  }

  .eva-password__logo-image {
    width: auto;
    height: var(--eva-password-logo-height, 3rem);
    margin-inline: auto;
  }

  /* Over photography the eyebrow takes the text colour; antique gold is not legible on images. */
  .eva-password__media ~ .eva-password__inner .eva-password__eyebrow {
    color: inherit;
  }

  .eva-password__heading {
    max-inline-size: 14em;
  }

  .eva-password__text {
    max-inline-size: 32rem;
    color: var(--eva-muted);
  }

  .eva-password__form {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    width: min(100%, 28.5rem);
    margin-block-start: 0.75rem;
  }

  .eva-password__input {
    flex: 1 1 14rem;
    min-width: 0;
    min-height: 2.875rem;
    padding-inline: 1rem;
    border: 1px solid var(--eva-border);
    border-radius: 0;
    background-color: #fff;
    color: var(--eva-charcoal);
    font-size: 0.875rem;
  }

  .eva-password__input::placeholder {
    color: var(--eva-grey);
    opacity: 1;
  }

  .eva-password__message {
    flex-basis: 100%;
    margin: 0.75rem 0 0;
    font-size: 0.8125rem;
  }

  .eva-password__enter {
    margin-block-start: 1.5rem;
    padding: 0.5rem 0;
    border: 0;
    background: none;
    cursor: pointer;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:eva.sections.password",
  "class": "eva-password-section",
  "enabled_on": {
    "templates": ["password"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:eva.settings.image"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "t:eva.settings.overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 35
    },
    {
      "type": "select",
      "id": "media_text",
      "label": "t:eva.settings.media_text",
      "info": "t:eva.info.media_text",
      "options": [
        { "value": "light", "label": "t:eva.options.light_text" },
        { "value": "dark", "label": "t:eva.options.dark_text" }
      ],
      "default": "light"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "t:eva.settings.color_scheme",
      "info": "t:eva.info.banner_color_scheme",
      "options": [
        { "value": "ivory", "label": "t:eva.options.ivory" },
        { "value": "blush", "label": "t:eva.options.blush" },
        { "value": "plum", "label": "t:eva.options.plum" },
        { "value": "charcoal", "label": "t:eva.options.charcoal" }
      ],
      "default": "ivory"
    },
    {
      "type": "text",
      "id": "wordmark",
      "label": "t:eva.settings.wordmark",
      "info": "t:eva.info.wordmark"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:eva.settings.eyebrow",
      "default": "Opening soon"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:eva.settings.heading",
      "info": "t:eva.info.heading_italic",
      "default": "Made to be seen, designed to be felt."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:eva.settings.text",
      "info": "t:eva.info.password_text"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "t:eva.settings.show_newsletter",
      "default": true
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "t:eva.settings.placeholder",
      "default": "Your email"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:eva.settings.button_label",
      "default": "Notify me"
    }
  ]
}
{% endschema %}
