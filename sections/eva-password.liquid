{%- liquid
  assign image = section.settings.image
  assign form_id = 'EvaPasswordSignup-' | append: section.id
  assign input_id = 'EvaPasswordEmail-' | append: section.id
  assign message_id = 'EvaPasswordMessage-' | append: section.id
  assign title = section.settings.heading | default: shop.name
-%}

<div class="eva-password eva-scheme-{{ section.settings.color_scheme }}">
  {%- comment -%}
    The photo floats on the left (on top on phones). It is the page's Largest Contentful Paint, so it
    loads first. Without an image chosen in the editor, the theme's own photo is used.
  {%- endcomment -%}
  <figure class="eva-password__photo eva-media">
    {%- if image != blank -%}
      {{
        image
        | image_url: width: 1400
        | image_tag:
          widths: '480, 640, 960, 1200, 1400',
          sizes: '(min-width: 750px) min(40vw, 34rem), calc(100vw - 2rem)',
          loading: 'eager',
          fetchpriority: 'high',
          preload: true,
          alt: image.alt
        }}
    {%- else -%}
      <img
        src="{{ 'eva-password-photo-960.webp' | asset_url }}"
        srcset="{{ 'eva-password-photo-640.webp' | asset_url }} 640w, {{ 'eva-password-photo-960.webp' | asset_url }} 960w, {{ 'eva-password-photo-1340.webp' | asset_url }} 1340w"
        sizes="(min-width: 750px) min(40vw, 34rem), calc(100vw - 2rem)"
        width="1340"
        height="1674"
        alt=""
        fetchpriority="high"
      >
    {%- endif -%}
  </figure>

  <div class="eva-password__content">
    {%- if section.settings.eyebrow != blank -%}
      <p class="eva-eyebrow eva-rise">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}

    <h1 class="eva-heading eva-password__title eva-rise">{{ title }}</h1>

    {%- if section.settings.text != blank -%}
      <div
        class="eva-body eva-rte eva-password__text eva-rise"
        style="--eva-rise-delay: 150ms;"
      >
        {{ section.settings.text }}
      </div>
    {%- elsif shop.password_message != blank -%}
      <p
        class="eva-body eva-password__text eva-rise"
        style="--eva-rise-delay: 150ms;"
      >
        {{ shop.password_message | escape }}
      </p>
    {%- endif -%}

    {%- if section.settings.show_newsletter -%}
      {%- form 'customer', id: form_id, class: 'eva-password__form eva-rise' -%}
        <input
          type="hidden"
          name="contact[tags]"
          value="newsletter, prelaunch"
        >
        <label
          for="{{ input_id }}"
          class="visually-hidden"
        >
          {{- 'eva.newsletter.email_label' | t -}}
        </label>
        <input
          id="{{ input_id }}"
          class="eva-password__input"
          type="email"
          name="contact[email]"
          autocomplete="email"
          autocapitalize="off"
          spellcheck="false"
          required
          placeholder="{{ section.settings.placeholder | escape }}"
          {% if form.errors %}
            aria-invalid="true"
            aria-describedby="{{ message_id }}"
          {% endif %}
        >
        <button
          type="submit"
          class="eva-button eva-button--primary"
        >
          {{- section.settings.button_label | escape -}}
        </button>
        {%- if form.posted_successfully? -%}
          <p
            id="{{ message_id }}"
            class="eva-password__message"
            role="status"
          >
            {{- 'eva.password.signup_success' | t -}}
          </p>
        {%- elsif form.errors -%}
          <p
            id="{{ message_id }}"
            class="eva-password__message"
            role="alert"
          >
            {{- 'eva.newsletter.error' | t -}}
          </p>
        {%- endif -%}
      {%- endform -%}
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .eva-password {
    display: grid;
    flex: 1;
    align-content: center;
    gap: clamp(2rem, 5vw, 4rem);
    padding: clamp(1.5rem, 4vw, 3rem) var(--eva-gutter);
  }

  /* A framed portrait with white space around it and a soft shadow, so it reads as floating. */
  .eva-password__photo {
    justify-self: center;
    width: min(100%, 26rem);
    max-height: 52svh;
    aspect-ratio: 4 / 5;
    margin: 0;
    box-shadow: 0 1.5rem 3rem -1rem rgb(43 34 38 / 0.25);
  }

  .eva-password__photo img {
    object-position: center top;
  }

  html.eva-ambient .eva-password__photo img {
    animation: eva-settle 4.5s var(--eva-ease-out) backwards;
  }

  .eva-password__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    text-align: center;
  }

  .eva-password__title {
    font-size: clamp(3rem, 1.6rem + 4.5vw, 6rem);
    line-height: 1;
  }

  .eva-password__text {
    max-inline-size: 30rem;
    color: var(--eva-muted);
  }

  .eva-password__text p {
    margin: 0;
  }

  .eva-password__form {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    width: min(100%, 28.5rem);
    margin-block-start: 0.5rem;
    --eva-rise-delay: 300ms;
  }

  .eva-password__input {
    flex: 1 1 14rem;
    min-width: 0;
    min-height: 2.875rem;
    padding-inline: 1rem;
    border: 1px solid var(--eva-border);
    border-radius: 0;
    background-color: #fff;
    color: var(--eva-charcoal);
    font-size: 0.875rem;
  }

  .eva-password__input::placeholder {
    color: var(--eva-grey);
    opacity: 1;
  }

  .eva-password__message {
    flex-basis: 100%;
    margin: 0.75rem 0 0;
    font-size: 0.8125rem;
  }

  @media screen and (min-width: 750px) {
    .eva-password {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      align-items: center;
      padding-inline: clamp(2rem, 6vw, 6rem);
    }

    .eva-password__photo {
      justify-self: start;
      width: min(100%, 34rem);
      max-height: calc(100svh - 10rem);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:eva.sections.password",
  "class": "eva-password-section",
  "enabled_on": {
    "templates": ["password"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:eva.settings.image",
      "info": "t:eva.info.password_image"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "t:eva.settings.color_scheme",
      "options": [
        { "value": "ivory", "label": "t:eva.options.ivory" },
        { "value": "blush", "label": "t:eva.options.blush" },
        { "value": "plum", "label": "t:eva.options.plum" },
        { "value": "charcoal", "label": "t:eva.options.charcoal" }
      ],
      "default": "ivory"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:eva.settings.eyebrow"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:eva.settings.heading",
      "info": "t:eva.info.password_heading",
      "default": "Eva Lingerie"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:eva.settings.text",
      "info": "t:eva.info.password_text",
      "default": "<p>Opening soon. Stay tuned and subscribe to be updated.</p>"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "t:eva.settings.show_newsletter",
      "default": true
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "t:eva.settings.placeholder",
      "default": "Your email"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:eva.settings.button_label",
      "default": "Subscribe"
    }
  ]
}
{% endschema %}
