{%- liquid
  assign comment_form_id = 'EvaComment-' | append: section.id
  assign comments_heading_id = 'EvaComments-' | append: section.id
-%}

<div
  class="eva-article eva-section eva-scheme-{{ section.settings.color_scheme }}"
  style="--eva-pt: {{ section.settings.padding_top }}px; --eva-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="eva-page">
    <nav
      class="eva-breadcrumbs"
      aria-label="{{ 'eva.product.breadcrumb' | t }}"
    >
      <ol role="list">
        <li><a href="{{ routes.root_url }}">{{ 'eva.breadcrumbs.home' | t }}</a></li>
        <li><a href="{{ blog.url }}">{{ blog.title | escape }}</a></li>
        <li aria-current="page">{{ article.title | escape }}</li>
      </ol>
    </nav>

    <article class="eva-article__body">
      <header class="eva-article__header">
        <p class="eva-eyebrow">{{ article.published_at | time_tag: format: 'date' }}</p>
        <h1 class="eva-heading eva-heading--lg">{{ article.title | escape }}</h1>
        {%- if section.settings.show_author and article.author != blank -%}
          <p class="eva-caption">{{ 'eva.article.by' | t: author: article.author }}</p>
        {%- endif -%}
      </header>

      {%- if article.image != blank -%}
        <figure class="eva-article__image eva-media">
          {%- comment -%} The lead image is the Largest Contentful Paint candidate. {%- endcomment -%}
          {{
            article.image
            | image_url: width: 2400
            | image_tag:
              widths: '375, 550, 750, 1100, 1500, 1800, 2400',
              sizes: '(min-width: 1320px) 1320px, 100vw',
              loading: 'eager',
              fetchpriority: 'high',
              preload: true,
              alt: article.image.alt
          }}
        </figure>
      {%- endif -%}

      <div class="eva-body eva-rte eva-article__content">{{ article.content }}</div>

      {%- if article.tags.size > 0 -%}
        <ul
          class="eva-article__tags"
          role="list"
          aria-label="{{ 'eva.blog.topics' | t }}"
        >
          {%- for tag in article.tags -%}
            <li>
              <a
                href="{{ blog.url }}/tagged/{{ tag | handleize }}"
                class="eva-chip"
              >
                {{- tag | escape -}}
              </a>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      <a
        href="{{ blog.url }}"
        class="eva-link eva-article__back"
      >
        {{- 'eva.article.back' | t: blog: blog.title -}}
      </a>
    </article>

    {%- if blog.comments_enabled? -%}
      <section
        class="eva-article__comments"
        aria-labelledby="{{ comments_heading_id }}"
      >
        <h2
          id="{{ comments_heading_id }}"
          class="eva-heading eva-heading--xs"
        >
          {{- 'eva.article.comments' | t: count: article.comments_count -}}
        </h2>

        {%- if article.comments_count > 0 -%}
          {%- paginate article.comments by 10 -%}
            <ol
              class="eva-article__comment-list"
              role="list"
            >
              {%- for comment in article.comments -%}
                <li class="eva-article__comment">
                  <div class="eva-body eva-rte">{{ comment.content }}</div>
                  <p class="eva-caption">
                    {{ comment.author | escape }} ·
                    {{ comment.created_at | time_tag: format: 'date' }}
                  </p>
                </li>
              {%- endfor -%}
            </ol>
            {%- render 'eva-pagination', paginate: paginate -%}
          {%- endpaginate -%}
        {%- endif -%}

        {%- form 'new_comment', article, id: comment_form_id, class: 'eva-article__comment-form' -%}
          <h3 class="eva-eyebrow">{{ 'eva.article.leave_comment' | t }}</h3>

          {%- if form.posted_successfully? -%}
            <p
              class="eva-form__status"
              role="status"
            >
              {%- if blog.moderated? -%}
                {{- 'eva.article.comment_moderated' | t -}}
              {%- else -%}
                {{- 'eva.article.comment_posted' | t -}}
              {%- endif -%}
            </p>
          {%- elsif form.errors -%}
            <div
              class="eva-form__status eva-form__status--error"
              role="alert"
            >
              {{ form.errors | default_errors }}
            </div>
          {%- endif -%}

          <div class="eva-form__row">
            <div class="eva-form__field">
              <label for="{{ comment_form_id }}-Name">{{ 'eva.contact.name' | t }}</label>
              <input
                id="{{ comment_form_id }}-Name"
                class="eva-form__input"
                type="text"
                name="comment[author]"
                autocomplete="name"
                required
                value="{{ form.author | escape }}"
              >
            </div>
            <div class="eva-form__field">
              <label for="{{ comment_form_id }}-Email">{{ 'eva.contact.email' | t }}</label>
              <input
                id="{{ comment_form_id }}-Email"
                class="eva-form__input"
                type="email"
                name="comment[email]"
                autocomplete="email"
                autocapitalize="off"
                spellcheck="false"
                required
                value="{{ form.email | escape }}"
              >
            </div>
          </div>
          <div class="eva-form__field">
            <label for="{{ comment_form_id }}-Body">{{ 'eva.article.comment' | t }}</label>
            <textarea
              id="{{ comment_form_id }}-Body"
              class="eva-form__input"
              name="comment[body]"
              rows="5"
              required
            >
              {{- form.body -}}
            </textarea>
          </div>
          {%- if blog.moderated? -%}
            <p class="eva-caption">{{ 'eva.article.moderation_note' | t }}</p>
          {%- endif -%}
          <button
            type="submit"
            class="eva-button eva-button--outline eva-form__submit"
          >
            {{- 'eva.article.post_comment' | t -}}
          </button>
        {%- endform -%}
      </section>
    {%- endif -%}
  </div>
</div>

{%- comment -%} Article markup maintained by Shopify, plus the breadcrumb trail. {%- endcomment -%}
{{ article | structured_data }}

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": {{ 'eva.breadcrumbs.home' | t | json }},
        "item": {{ shop.url | json }}
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": {{ blog.title | json }},
        "item": {{ shop.url | append: blog.url | json }}
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": {{ article.title | json }},
        "item": {{ shop.url | append: article.url | json }}
      }
    ]
  }
</script>

{% stylesheet %}
  .eva-article__body,
  .eva-article__comments {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-inline-size: 44rem;
    margin-inline: auto;
  }

  .eva-article__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    padding-block: 1rem 0.5rem;
    text-align: center;
  }

  .eva-article__image {
    aspect-ratio: 3 / 2;
    margin: 0;
  }

  @media screen and (min-width: 990px) {
    /* The lead image breaks out of the text column. */
    .eva-article__image {
      inline-size: min(100vw - 2 * var(--eva-gutter), var(--eva-page-max));
      margin-inline: calc((min(100vw - 2 * var(--eva-gutter), var(--eva-page-max)) - 44rem) / -2);
      aspect-ratio: 21 / 9;
    }
  }

  .eva-article__content {
    font-size: 1rem;
    line-height: 1.8;
  }

  .eva-article__content :is(h2, h3, h4) {
    margin-block: 2em 0.6em;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    line-height: 1.2;
  }

  .eva-article__content h2 {
    font-size: 1.875rem;
  }

  .eva-article__content h3 {
    font-size: 1.5rem;
  }

  .eva-article__content a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: currentcolor;
    text-underline-offset: 0.2em;
  }

  .eva-article__content img {
    height: auto;
  }

  .eva-article__content blockquote {
    margin: 2em 0;
    padding-inline-start: 1.25rem;
    border-inline-start: 1px solid var(--eva-gold-text);
    font-family: var(--font-heading--family);
    font-size: 1.375rem;
    font-style: italic;
  }

  .eva-article__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .eva-article__back {
    align-self: flex-start;
  }

  .eva-article__comments {
    margin-block-start: clamp(3rem, 6vw, 4.5rem);
    padding-block-start: 2rem;
    border-block-start: 1px solid var(--eva-line);
  }

  .eva-article__comment-list {
    display: grid;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .eva-article__comment {
    padding-block-end: 1.5rem;
    border-block-end: 1px solid var(--eva-line);
  }

  .eva-article__comment-form {
    display: grid;
    gap: 1.25rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:eva.sections.main_article",
  "class": "eva-main-article-section",
  "enabled_on": {
    "templates": ["article"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "t:eva.settings.show_author",
      "default": true
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "t:eva.settings.color_scheme",
      "options": [
        { "value": "ivory", "label": "t:eva.options.ivory" },
        { "value": "blush", "label": "t:eva.options.blush" }
      ],
      "default": "ivory"
    },
    {
      "type": "header",
      "content": "t:eva.content.spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:eva.settings.padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:eva.settings.padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 96
    }
  ]
}
{% endschema %}
