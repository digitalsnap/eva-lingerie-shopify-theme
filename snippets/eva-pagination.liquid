{%- doc -%}
  Numbered pagination ("1 2 3 Next >") built from a {% paginate %} block. Plain links, no JavaScript.

  @param {object} paginate - The paginate object from the surrounding {% paginate %} tag.

  @example
  {% render 'eva-pagination', paginate: paginate %}
{%- enddoc -%}

{%- if paginate.pages > 1 -%}
  <nav
    class="eva-pagination"
    aria-label="{{ 'eva.pagination.label' | t }}"
  >
    <ul
      class="eva-pagination__list"
      role="list"
    >
      {%- if paginate.previous -%}
        <li>
          <a
            href="{{ paginate.previous.url }}"
            class="eva-pagination__link eva-pagination__step"
          >
            <span aria-hidden="true">&lsaquo;</span>
            {{ 'eva.pagination.previous' | t -}}
          </a>
        </li>
      {%- endif -%}

      {%- for part in paginate.parts -%}
        <li>
          {%- if part.is_link -%}
            <a
              href="{{ part.url }}"
              class="eva-pagination__link"
              aria-label="{{ 'eva.pagination.page' | t: number: part.title }}"
            >
              {{- part.title -}}
            </a>
          {%- elsif part.title contains 'hellip' -%}
            <span class="eva-pagination__gap">&hellip;</span>
          {%- else -%}
            <span
              class="eva-pagination__link"
              aria-current="page"
            >
              <span class="visually-hidden">{{ 'eva.pagination.page' | t: number: part.title }}</span>
              <span aria-hidden="true">{{ part.title }}</span>
            </span>
          {%- endif -%}
        </li>
      {%- endfor -%}

      {%- if paginate.next -%}
        <li>
          <a
            href="{{ paginate.next.url }}"
            class="eva-pagination__link eva-pagination__step"
          >
            {{- 'eva.pagination.next' | t }}
            <span aria-hidden="true">&rsaquo;</span>
          </a>
        </li>
      {%- endif -%}
    </ul>
  </nav>
{%- endif -%}

{% stylesheet %}
  .eva-pagination__list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .eva-pagination__link,
  .eva-pagination__gap {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    min-width: 2.75rem;
    min-height: 2.75rem;
    padding-inline: 0.5rem;
    font-size: 0.8125rem;
    color: inherit;
    text-decoration: none;
  }

  .eva-pagination__step {
    font-family: var(--font-subheading--family);
    font-weight: var(--font-subheading--weight);
    font-size: 0.6875rem;
    letter-spacing: var(--eva-tracking-label);
    text-transform: uppercase;
  }

  a.eva-pagination__link:hover {
    text-decoration: underline;
    text-decoration-color: currentcolor;
    text-underline-offset: 0.35em;
  }

  .eva-pagination__link[aria-current] {
    text-decoration: underline;
    text-decoration-color: currentcolor;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.35em;
  }

  .eva-pagination__link:focus-visible {
    outline: 2px solid currentcolor;
    outline-offset: 2px;
  }
{% endstylesheet %}
