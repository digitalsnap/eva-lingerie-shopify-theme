{%- doc -%}
  Eva head assets: font preconnect and preloads, the Eva base stylesheet and brand tokens.
  Rendered after Horizon's stylesheets so Eva rules win at equal specificity.

  Only the heading and subheading fonts are preloaded: they are the two faces used above the fold
  (hero headline; announcement, navigation, eyebrow and buttons), so the browser fetches them
  alongside the CSS instead of after it.

  @example
  {% render 'eva-head' %}
{%- enddoc -%}

<link
  rel="preconnect"
  href="https://fonts.shopifycdn.com"
  crossorigin
>

{%- unless settings.type_heading_font.system? -%}
  {{ settings.type_heading_font | font_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: true }}
{%- endunless -%}

{%- unless settings.type_subheading_font.system? -%}
  {{ settings.type_subheading_font | font_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: true }}
{%- endunless -%}

{{ 'eva-base.css' | asset_url | stylesheet_tag: preload: true }}

{%- if settings.eva_motion -%}
  {%- comment -%}
    Decided before first paint so nothing jumps: visitors who ask for reduced motion get none.
    assets/eva-motion.js adds the scroll reveals; the drift and the headline rise are CSS.
  {%- endcomment -%}
  <script>
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.documentElement.classList.add('eva-motion'{% if settings.eva_motion_ambient %}, 'eva-ambient'{% endif %});
    }
  </script>
  <script
    src="{{ 'eva-motion.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
{%- endif -%}

{%- render 'eva-tokens' -%}
